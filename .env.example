# Docker Compose infrastructure
POSTGRES_DB=dominiohub
POSTGRES_USER=dominiohub
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Backend runtime
NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080
TRUST_PROXY=0
DATABASE_URL=postgresql://dominiohub:replace-with-a-strong-postgres-password@postgres:5432/dominiohub?schema=public
REDIS_URL=redis://redis:6379

# Authentication
JWT_SECRET=change-this-with-a-secure-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=dominiohub-api
JWT_AUDIENCE=dominiohub-web

# Domain, cache and webhook settings
DOMAIN_PROVIDER=mock
CACHE_TTL_SECONDS=300
# Public example only. Replace with a fresh value from: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_HISTORY_LIMIT=20
AI_REQUEST_TIMEOUT_MS=120000

# Local/demo bootstrap: true creates demo users and data after migrations;
# false leaves the database without demo data (recommended for future production environments).
DEMO_SEED_ENABLED=true

# Frontend build-time API URL. Use a browser-reachable URL in deployed environments.
VITE_API_URL=http://localhost:3000/api/v1
