# Public host and ports
FRONTEND_PORT=80
HTTPS_PORT=443
BACKEND_PORT=3000
FRONTEND_URL=https://CHANGE_ME_PUBLIC_HOST
API_PUBLIC_URL=https://CHANGE_ME_PUBLIC_HOST
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_PUBLIC_HOST
VITE_API_URL=https://CHANGE_ME_PUBLIC_HOST/api/v1

# Application
NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# PostgreSQL
POSTGRES_DB=dominiohub
POSTGRES_USER=dominiohub
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://dominiohub:CHANGE_ME@postgres:5432/dominiohub?schema=public

# Redis
REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=300

# Authentication
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h
JWT_ISSUER=dominiohub-api
JWT_AUDIENCE=dominiohub-web

# Domains and webhooks
DOMAIN_PROVIDER=mock
# Public example only. Replace with a fresh value from: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.5-flash-lite
AI_HISTORY_LIMIT=20
AI_REQUEST_TIMEOUT_MS=120000

# Demo data
DEMO_SEED_ENABLED=false
