NODE_ENV=development
PORT=3000

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=0

DATABASE_URL="postgresql://dominiohub:replace-with-your-postgres-password@localhost:5433/dominiohub?schema=public"

JWT_SECRET=change-this-with-a-secure-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=dominiohub-api
JWT_AUDIENCE=dominiohub-web

DOMAIN_PROVIDER=mock

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Public example only. Replace with a fresh value from: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_HISTORY_LIMIT=20
AI_REQUEST_TIMEOUT_MS=120000
