NODE_ENV=development
PORT=3000

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=0

DATABASE_URL="postgresql://dominiohub:dominiohub_dev@localhost:5433/dominiohub?schema=public"

JWT_SECRET=change-this-with-a-secure-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=dominiohub-api
JWT_AUDIENCE=dominiohub-web

DOMAIN_PROVIDER=mock

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

WEBHOOK_SECRET_ENCRYPTION_KEY=

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_HISTORY_LIMIT=20
AI_REQUEST_TIMEOUT_MS=120000
